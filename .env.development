# Local development talks to the Firebase emulators (run `npm run emulators` first).
# To develop against your real project instead, put your web config in .env.development.local
# and set VITE_USE_EMULATORS=false there.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-badminton.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-badminton
VITE_FIREBASE_APP_ID=demo-app-id
