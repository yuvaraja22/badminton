# Copy these into Vercel → Project → Settings → Environment Variables
# (values come from Firebase console → Project settings → Your apps → Web app config).
# They are public identifiers, not secrets; Firestore security rules protect the data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
VITE_USE_EMULATORS=false
