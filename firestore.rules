rules_version = '2';

// Anyone with the link can read; only admins listed in /admins/{email} can write.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedInEmail() {
      return request.auth.token.get('email', '').lower();
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.get('email_verified', false) == true
        && exists(/databases/$(database)/documents/admins/$(signedInEmail()));
    }

    match /players/{playerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sessions/{sessionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /meta/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // The admin list itself stays private. A signed-in user may check their own entry.
    match /admins/{email} {
      allow get: if request.auth != null && signedInEmail() == email;
      allow read: if isAdmin();
      allow write: if isAdmin() && email == email.lower();
    }
  }
}
